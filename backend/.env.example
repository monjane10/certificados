# Porta do backend (ex.: 4000)
PORT=4000
# Origem do frontend permitida no CORS (várias separadas por vírgula)
CLIENT_ORIGIN=http://localhost:5173
# N.º de proxies à frente do servidor: 0 em local, 1 atrás de Nginx/Render/Railway
TRUST_PROXY=0
# URL do projecto Supabase (Project Settings -> Data API -> Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública anon (Project Settings -> API Keys -> anon public). NUNCA a service_role.
SUPABASE_PUBLISHABLE_KEY=
# Chave service_role (Project Settings -> API Keys). SÓ no servidor, nunca no frontend.
# Obrigatória para os pagamentos dos certificados.
SUPABASE_SERVICE_ROLE_KEY=
# Pagamentos: desactivado | simulado (desenvolvimento; números terminados em 000 falham)
PAYMENT_PROVIDER=desactivado
